# =============================================================================
# Distributed Vector & Embedding Lake — environment template
# =============================================================================
# Copy to `.env` (gitignored) and replace the placeholders:
#   cp .env.example .env
# Every value below is a placeholder; none is a working credential. The Qdrant
# key is a label for local development only and must be rotated before the API
# is exposed beyond loopback.

# --- Vector database ---------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=replace-with-local-qdrant-api-key
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_MEM_LIMIT=8g
QDRANT_CPUS=4

# --- Collection and vector shape --------------------------------------------
COLLECTION_NAME=rag_documents
VECTOR_SIZE=384
DISTANCE=Cosine

# --- Embedding model ---------------------------------------------------------
# provider: hashing (offline, deterministic) or sentence-transformers
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Ingestion pipeline ------------------------------------------------------
DATASET_PATH=/data/sample_documents.jsonl
CHUNK_SIZE=800
CHUNK_OVERLAP=120
INGEST_BATCH_SIZE=64
WORKER_MEM_LIMIT=4g
WORKER_CPUS=2

# --- Retrieval API -----------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8085
API_MEM_LIMIT=2g
API_CPUS=1
TOP_K=5

# --- Local persistence (gitignored) -----------------------------------------
VECTOR_STORAGE_DIR=../storage/qdrant
VECTOR_SNAPSHOT_DIR=../storage/snapshots

# --- Runtime -----------------------------------------------------------------
LOG_LEVEL=INFO
TZ=UTC
