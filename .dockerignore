# Never send vector data, credentials or local state into the image build.
.git
.gitignore
storage/
snapshots/
*.db
*.sqlite*
*.snapshot
*.dump
data/
runtime/
logs/
*.log
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/
keys/
terraform/
.terraform/
*.tfstate*
*.tfvars
!terraform.tfvars.example
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
docs/
tests/
node_modules/
dist/
build/
.idea/
.vscode/
.DS_Store
